# Copia este archivo como .env y cambia los valores para tu equipo.
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_USER=induztek
MYSQL_PASSWORD=induztek_dev_password
JWT_SECRET=CAMBIA-ESTA-CLAVE-LOCAL-POR-UNA-DE-AL-MENOS-32-BYTES-2026
JWT_EXPIRATION_MINUTES=60
TOKEN_EXPIRATION_MINUTES=30
EXPOSE_DEV_TOKENS=true

# Para correo real, configura SMTP y MAIL_ENABLED=true.
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
