# ==========================================
# INDuztek APP - VARIABLES DE ENTORNO
# ==========================================

# MySQL - EJECUCION LOCAL CON LARAGON
# No crear usuarios adicionales: root / contraseña vacia
DB_USERNAME=root
DB_PASSWORD=

# MySQL - DOCKER (solo se usan al ejecutar Docker)
MYSQL_ROOT_PASSWORD=CAMBIA_ESTA_CLAVE_ROOT_DOCKER
DB_USUARIOS_PASSWORD=CAMBIA_CLAVE_USUARIOS_DOCKER
DB_ACTIVOS_PASSWORD=CAMBIA_CLAVE_ACTIVOS_DOCKER
DB_PROTOCOLS_PASSWORD=CAMBIA_CLAVE_PROTOCOLOS_DOCKER

# JWT - mismo secreto para Usuarios, Activos y Protocolos
# Sustituir por un secreto aleatorio de al menos 32 bytes
JWT_SECRET=REEMPLAZA_POR_UN_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS
JWT_EXPIRATION_MINUTES=60
TOKEN_EXPIRATION_MINUTES=30

# Comunicacion interna - mismo token en los tres microservicios
INTERNAL_SERVICE_TOKEN=REEMPLAZA_POR_UN_TOKEN_INTERNO_ALEATORIO_Y_LARGO

# Gmail SMTP - se puede dejar deshabilitado si no se configurara correo
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Seguridad
EXPOSE_DEV_TOKENS=false
